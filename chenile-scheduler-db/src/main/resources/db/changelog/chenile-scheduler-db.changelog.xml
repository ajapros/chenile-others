<?xml version="1.0" encoding="UTF-8"?>
<!--
  Liquibase changelog for chenile-scheduler-db: chenile_schedule and its headers. Opt-in via the
  "chenile-scheduler-db" context. The columns from BaseJpaEntity (id, created_time, last_modified_time,
  last_modified_by, tenant, created_by, version) follow Spring Boot's default snake_case naming.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="chenile-schedule" author="chenile-scheduler-db" context="chenile-scheduler-db">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="chenile_schedule"/></not>
        </preConditions>
        <createTable tableName="chenile_schedule">
            <column name="id" type="VARCHAR(255)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="created_time" type="TIMESTAMP"/>
            <column name="last_modified_time" type="TIMESTAMP"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="tenant" type="VARCHAR(255)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="cron_expression" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="timezone" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="event_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="payload" type="TEXT"/>
            <column name="enabled" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>
        <addUniqueConstraint tableName="chenile_schedule" columnNames="tenant, name"
                             constraintName="uk_chenile_schedule_tenant_name"/>
        <createIndex tableName="chenile_schedule" indexName="idx_chenile_schedule_tenant">
            <column name="tenant"/>
        </createIndex>
        <createTable tableName="chenile_schedule_header">
            <column name="schedule_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="fk_chenile_schedule_header"
                             references="chenile_schedule(id)"/>
            </column>
            <column name="header_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="header_value" type="VARCHAR(1024)"/>
        </createTable>
        <addPrimaryKey tableName="chenile_schedule_header" columnNames="schedule_id, header_name"
                       constraintName="pk_chenile_schedule_header"/>
    </changeSet>
</databaseChangeLog>
